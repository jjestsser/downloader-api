# Copy to .env for local dev. On Railway these are service variables — never commit real values.
# Every variable below maps 1:1 to a field on Settings in app/settings.py.

# --- core -------------------------------------------------------------------------------
ENVIRONMENT=development
PORT=8080

# Redis. Locally this is the compose service; on Railway use the private-network URL that the
# Redis plugin injects (redis.railway.internal) so the traffic never leaves the project.
REDIS_URL=redis://localhost:6379/0

# --- ticket signing ---------------------------------------------------------------------
# HMAC-SHA256 key shared with whatever mints tickets (the portfolio frontend's edge route).
# Generate: openssl rand -hex 32
TICKET_SECRET=replace-me-with-32-bytes-of-hex

# Salt for sha256(ip + salt)[:16]. Rotating it resets everyone's daily quota, so rotate at a
# day boundary or not at all. It exists so the stored quota keys are not reversible to an IP.
# Generate: openssl rand -hex 16
IP_SALT=replace-me-with-16-bytes-of-hex

# --- Cloudflare Turnstile ---------------------------------------------------------------
# Server-side secret only. The sitekey lives in the frontend.
# Cloudflare's always-passes test secret: 1x0000000000000000000000000000000AA
TURNSTILE_SECRET=1x0000000000000000000000000000000AA

# --- CORS -------------------------------------------------------------------------------
# Comma-separated exact origins. No wildcard: a wildcard here plus credentialed requests is
# how a ticket ends up being spent by someone else's page.
ALLOWED_ORIGINS=http://localhost:3000,https://kavithakanchana.me

# --- Cloudflare R2 (S3-compatible) ------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=downloader-artifacts
# Public base used to build presigned URLs, e.g. https://cdn.dl.example.com or the
# https://<account>.r2.cloudflarestorage.com/<bucket> endpoint. No trailing slash.
R2_PUBLIC_BASE=

# LOCAL ONLY. Aims the same upload/presign code at docker-compose's MinIO so the worker
# path can be tested without touching Cloudflare. Leave it EMPTY everywhere else: it beats
# R2_ACCOUNT_ID, and on a host 127.0.0.1 is the container itself, so every upload hits a
# refused connection. It is undocumented here no longer because copying a working local
# .env straight into the platform's variables is exactly how that happened. The service now
# refuses to boot with a loopback value when ENVIRONMENT is production or staging.
R2_ENDPOINT_URL_OVERRIDE=

# The one writable path. /scratch in the container (the Dockerfile creates it owned by
# uid 10001); a real directory on your machine, which has no /scratch.
SCRATCH_DIR=/scratch

# --- limits -----------------------------------------------------------------------------
# Anything longer than an hour is a livestream or a movie rip; both are worker-path poison.
MAX_DURATION_S=3600
MAX_FILESIZE_MB=500
# Per IP hash, per UTC day.
RESOLVE_QUOTA_PER_DAY=30
BYTES_QUOTA_GB_PER_DAY=2

# Global daily spend ceiling in micro-USD (1_000_000 = $1). When spend:{YYYYMMDD} crosses this,
# killswitch:global trips and every resolve/job returns killswitch_active(503). This is the
# single control that stops a scraper farm from turning residential proxy egress into a bill.
# 5_000_000 = $5/day.
DAILY_SPEND_CAP_MICRO_USD=5000000

# How long a finished artifact stays in R2 and how long its presigned URL is valid.
# Must be <= the bucket lifecycle rule (6h). 21600 = 6h.
RESULT_TTL_S=21600

# --- observability ----------------------------------------------------------------------
# Bearer token required by GET /metrics. Unauthenticated metrics leak traffic volume and
# platform-degradation state to anyone probing the domain.
# Generate: openssl rand -hex 24
METRICS_TOKEN=replace-me

# --- proxies (optional; leave blank to disable that tier) --------------------------------
# Datacenter tier: cheap, first escalation step, burns out on YouTube within hours.
PROXY_DATACENTER_URL=
# Residential tier: expensive per GB. proxy_for() only reaches for this after the canary
# marks a platform degraded, because this is the line item that can produce a $180/1000 bill.
PROXY_RESIDENTIAL_URL=
